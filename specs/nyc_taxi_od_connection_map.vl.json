{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"name": "databricks_query"},
  "width": "container",
  "height": "container",
  "background": "#DCECF5",
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "padding": 12,
  "projection": {"type": "mercator"},
  "transform": [
    {"calculate": "datum.duration_total / datum.trip_count", "as": "mean_duration_min"},
    {
      "window": [{"op": "rank", "as": "destination_rank"}],
      "sort": [{"field": "trip_count", "order": "descending"}],
      "groupby": ["origin_zone"]
    },
    {"filter": "datum.destination_rank <= 6"}
  ],
  "layer": [
    {
      "data": {"name": "nyc_basemap"},
      "mark": {"type": "geoshape", "stroke": "#FFFFFF", "strokeWidth": 0.7, "opacity": 0.97},
      "encoding": {
        "color": {
          "field": "properties.borough",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island", "EWR"],
            "range": ["#F4E1B9", "#D8E8D3", "#E4DDF0", "#F1D2CC", "#D1E4D4", "#E2DED4"]
          }
        }
      }
    },
    {
      "transform": [{"filter": {"param": "origin_select", "empty": false}}],
      "mark": {"type": "rule", "strokeCap": "round", "opacity": 0.66},
      "encoding": {
        "longitude": {"field": "origin_longitude", "type": "quantitative"},
        "latitude": {"field": "origin_latitude", "type": "quantitative"},
        "longitude2": {"field": "destination_longitude"},
        "latitude2": {"field": "destination_latitude"},
        "size": {"field": "trip_count", "type": "quantitative", "scale": {"type": "sqrt", "range": [1.2, 8]}, "legend": null},
        "color": {
          "field": "mean_duration_min",
          "type": "quantitative",
          "scale": {"scheme": "yelloworangered", "domainMin": 4},
          "legend": {"title": "Mean minutes", "orient": "bottom", "gradientLength": 150}
        },
        "tooltip": [
          {"field": "origin_zone", "title": "From"},
          {"field": "destination_zone", "title": "To"},
          {"field": "trip_count", "type": "quantitative", "format": ",d", "title": "Trips in selection"},
          {"field": "mean_duration_min", "type": "quantitative", "format": ".1f", "title": "Mean minutes"}
        ]
      }
    },
    {
      "transform": [{"filter": {"param": "origin_select", "empty": false}}],
      "mark": {"type": "circle", "filled": true, "color": "#2D7F78", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "destination_longitude", "type": "quantitative"},
        "latitude": {"field": "destination_latitude", "type": "quantitative"},
        "size": {"field": "trip_count", "type": "quantitative", "scale": {"type": "sqrt", "range": [35, 360]}, "legend": null},
        "tooltip": [
          {"field": "destination_zone", "title": "Destination"},
          {"field": "trip_count", "type": "quantitative", "format": ",d", "title": "Trips in selection"}
        ]
      }
    },
    {
      "params": [{"name": "origin_select", "select": {"type": "point", "fields": ["origin_zone"], "on": "click", "clear": "dblclick"}}],
      "transform": [
        {
          "aggregate": [{"op": "sum", "field": "trip_count", "as": "origin_trip_count"}],
          "groupby": ["origin_zone", "pickup_borough", "origin_longitude", "origin_latitude"]
        }
      ],
      "mark": {"type": "circle", "filled": true, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "origin_longitude", "type": "quantitative"},
        "latitude": {"field": "origin_latitude", "type": "quantitative"},
        "size": {"condition": {"param": "origin_select", "empty": false, "value": 480}, "value": 135},
        "color": {
          "field": "pickup_borough",
          "type": "nominal",
          "legend": {"title": "Origin borough", "orient": "bottom", "direction": "horizontal"},
          "scale": {
            "domain": ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island"],
            "range": ["#F2A900", "#2D7F78", "#243B64", "#B84A3A", "#AB4057"]
          }
        },
        "opacity": {"condition": {"param": "origin_select", "empty": false, "value": 1}, "value": 0.68},
        "tooltip": [
          {"field": "origin_zone", "title": "Click to select origin"},
          {"field": "pickup_borough", "title": "Borough"},
          {"field": "origin_trip_count", "type": "quantitative", "format": ",d", "title": "Top-six trip volume"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [{"op": "sum", "field": "trip_count", "as": "origin_trip_count"}],
          "groupby": ["origin_zone", "origin_longitude", "origin_latitude"]
        },
        {"filter": {"param": "origin_select", "empty": false}}
      ],
      "mark": {"type": "text", "dy": -10, "fontSize": 10, "fontWeight": "bold", "color": "#243B64", "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "origin_longitude", "type": "quantitative"},
        "latitude": {"field": "origin_latitude", "type": "quantitative"},
        "text": {"field": "origin_zone", "type": "nominal"}
      }
    }
  ],
  "resolve": {"scale": {"color": "independent"}},
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "legend": {"labelColor": "#4B5563", "titleColor": "#4B5563", "labelFontSize": 10, "titleFontSize": 10}
  }
}
